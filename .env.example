# ============================================================
# SCRUB Dashboard — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# NOTE: The dashboard ships with the scrub-v4 Firebase project
# pre-configured as defaults. You only need this file if you
# want to use a DIFFERENT Firebase project.
# ============================================================

# ── Mapbox (required for the map to render) ─────────────────
VITE_LOVABLE_CONNECTOR_MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_token_here

# ── Firebase Realtime Database ───────────────────────────────
# Leave blank to use the built-in scrub-v4 defaults.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Path inside the Realtime Database where telemetry is published
# Default: sensorData/current
VITE_FIREBASE_TELEMETRY_PATH=sensorData/current
